NODE_ENV=development

JWT_SECRET=123456
JWT_EXPIRATION_TIME=2h
JWT_REFRESH_EXPIRATION_TIME=7d

POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost # use "postgres" inside docker, "localhost" for local development
POSTGRES_PORT=5432
POSTGRES_DB_NAME=dchurch_crm

REDIS_HOST=localhost # use "redis" inside docker, "localhost" for local development
REDIS_PORT=6379
REDIS_PASSWORD=123456

APP_URL=http://localhost:3000

# Production only: where the API looks for the client build.
# Defaults to ../client/dist relative to the API's working directory.
# CLIENT_DIST_PATH=/srv/dchurch-crm/client

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}?schema=public"
