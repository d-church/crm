NODE_ENV=development

# Supabase — transaction-mode pooler for the app…
DATABASE_URL="postgresql://postgres.nfzqdmsjriawosznxapc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# …and session-mode pooler for migrations and Prisma Studio.
DIRECT_URL="postgresql://postgres.nfzqdmsjriawosznxapc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=123456
JWT_EXPIRATION_TIME=2h
JWT_REFRESH_EXPIRATION_TIME=7d

# Upstash Redis — rediss:// keeps the connection over TLS.
REDIS_URL="rediss://default:[YOUR-TOKEN]@in-squirrel-183306.upstash.io:6379"

APP_URL=http://localhost:3000

# Production only: where the API looks for the client build.
# Defaults to ../client/dist relative to the API's working directory.
