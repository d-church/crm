NODE_ENV=development

# Port the app listens on. In production the API serves the client build on this
# same port, so this is the only port the deployment exposes (e.g. PORT=3012).
PORT=3000

# Dev only: Vite's dev server port. It proxies /api and /uploads to PORT above.
CLIENT_PORT=3001

# Comma-separated origins allowed through CORS. Replaces the built-in list
# (the local dev ports plus https://crm.dchurch.lviv.ua) — set it only when the
# client is served from somewhere other than this API.
# CORS_ORIGIN=https://crm.dchurch.lviv.ua

# Supabase — transaction-mode pooler for the app…
DATABASE_URL="postgresql://postgres.nfzqdmsjriawosznxapc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# …and session-mode pooler for migrations and Prisma Studio.
DIRECT_URL="postgresql://postgres.nfzqdmsjriawosznxapc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# For local development, DATABASE_URL and DIRECT_URL should both point to the
# PostgreSQL Docker container started by `pnpm db:dev:up`:
# postgresql://postgres:postgres@localhost:5433/dchurch_crm

# Local development only. `pnpm sync-dev-db` reads this direct/session endpoint
# and restores it into DATABASE_URL. Do not configure this variable in production.
DB_SYNC_SOURCE_URL="postgresql://postgres.nfzqdmsjriawosznxapc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Optional overrides for compose.dev-db.yaml. They must match DATABASE_URL.
# LOCAL_POSTGRES_PORT=5433
# LOCAL_POSTGRES_DB=dchurch_crm
# LOCAL_POSTGRES_USER=postgres
# LOCAL_POSTGRES_PASSWORD=postgres

JWT_SECRET=123456
JWT_EXPIRATION_TIME=2h
JWT_REFRESH_EXPIRATION_TIME=7d

# Upstash Redis — rediss:// keeps the connection over TLS.
REDIS_URL="rediss://default:[YOUR-TOKEN]@in-squirrel-183306.upstash.io:6379"

# Production only: where the API looks for the client build.
# Defaults to ../client/dist relative to the API's working directory.
# CLIENT_DIST_PATH=/srv/dchurch-crm/client
