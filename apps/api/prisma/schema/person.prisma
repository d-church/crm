/// The church's own pipeline: перший візит → контакт → наступний крок → спільнота → служіння.
/// CARE and INACTIVE sit outside the ladder — one needs attention, the other stopped coming.
enum PersonStatus {
  NEW
  CONNECTED
  NEXT_STEP
  COMMUNITY
  SERVING
  CARE
  INACTIVE

  @@map("person_statuses")
}

enum FollowUpState {
  NOT_DONE
  PLANNED
  DONE

  @@map("follow_up_states")
}

/// A person known to the church, with the follow-up card the pastoral team keeps on them.
model Person {
  id String @id @default(uuid())

  firstName String  @map("first_name")
  lastName  String? @map("last_name")

  email String?
  phone String?
  /** Home and work numbers carried over from the old Access database. */
  homePhone String? @map("home_phone")
  workPhone String? @map("work_phone")

  city       String?
  address    String?
  postalCode String? @map("postal_code")
  district   String?
  region     String?

  status PersonStatus @default(NEW)

  /// Перший візит — when the person first showed up.
  firstVisitAt DateTime? @map("first_visit_at") @db.Date
  /// Остання зустріч — last time they were seen at a gathering.
  lastSeenAt   DateTime? @map("last_seen_at") @db.Date

  /// Connect — who from the team made contact. Free text until people can link to people.
  connectedBy String?       @map("connected_by")
  followUp    FollowUpState @default(NOT_DONE) @map("follow_up")
  /// Next Step — the step they are going through, e.g. "зустріч для нових".
  nextStep    String?       @map("next_step")

  /// Спільнота — the group they belong to; empty means "ще немає".
  community String?
  ministry  String?

  /// Відповідальний — team member carrying this person.
  responsible String?
  /// Наступна дія — what to do next, and when.
  nextAction   String?   @map("next_action")
  nextActionAt DateTime? @map("next_action_at") @db.Date

  birthDate DateTime? @map("birth_date") @db.Date
  /// Водне хрещення.
  baptizedAt DateTime? @map("baptized_at") @db.Date
  /// Став членом церкви.
  memberSince DateTime? @map("member_since") @db.Date
  /// Вибув з членства.
  leftAt DateTime? @map("left_at") @db.Date

  notes String?

  /// Код_ЧлениЦеркви from the imported Access database — keeps the import idempotent.
  legacyId Int? @unique @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([status])
  @@map("people")
}
