/// Ким людина є для церкви. Змінюється рідко і лише одне значення за раз.
enum MembershipStatus {
  SUBSCRIBER
  GUEST
  ATTENDER
  MEMBER
  FORMER_MEMBER

  @@map("membership_statuses")
}

/// Чи людина зараз тут. Не залежить від статусу: член церкви може бути за кордоном.
enum ActivityState {
  ACTIVE
  ABROAD
  INACTIVE
  MOVED

  @@map("activity_states")
}

enum FollowUpState {
  NOT_DONE
  PLANNED
  DONE

  @@map("follow_up_states")
}

enum PersonGender {
  MALE
  FEMALE

  @@map("person_genders")
}

/// A person known to the church, with the follow-up card the pastoral team keeps on them.
model Person {
  id String @id @default(uuid())

  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  gender    PersonGender?

  email     String?
  phone     String?
  /**
   * Home and work numbers carried over from the old Access database.
   */
  homePhone String? @map("home_phone")
  workPhone String? @map("work_phone")

  city       String?
  address    String?
  postalCode String? @map("postal_code")
  district   String?
  region     String?

  /// Статус — підписник, гість, прихожанин, член церкви, колишній член.
  membership MembershipStatus @default(GUEST)
  /// Активність — чи людина зараз тут, окремо від її статусу.
  activity   ActivityState    @default(ACTIVE)
  /// Потребує пасторської уваги — прапорець, а не статус: він поєднується з будь-яким.
  careNeeded Boolean          @default(false) @map("care_needed")

  /// Перший візит — when the person first showed up.
  firstVisitAt DateTime? @map("first_visit_at") @db.Date
  /// Остання зустріч — last time they were seen at a gathering.
  lastSeenAt   DateTime? @map("last_seen_at") @db.Date

  /// Connect — who from the team made contact. Free text until people can link to people.
  connectedBy String?       @map("connected_by")
  followUp    FollowUpState @default(NOT_DONE) @map("follow_up")
  /// Наступні кроки — окремі задачі з довідника, а не одне текстове поле.
  steps       PersonStep[]

  /// Спільноти — a person can participate in any number of communities.
  communities Community[]
  /// A person can belong to at most one home group.
  homeGroupId String?    @map("home_group_id")
  homeGroup   HomeGroup? @relation("HomeGroupMembers", fields: [homeGroupId], references: [id], onDelete: SetNull)
  /// A leader may lead several home groups without being a member of them.
  leadingHomeGroups HomeGroup[] @relation("HomeGroupLeader")
  /// A leader may lead several communities without being a member of them.
  leadingCommunities Community[] @relation("CommunityLeader")
  /// Події, які команда вносить руками: одруження, переїзд, свідчення.
  events PersonEvent[] @relation("PersonEvents")
  /// Контакти, де ця людина була представником церкви.
  contacts PersonEvent[] @relation("PersonContacts")
  /// Журнал операцій над карткою — хто і що змінив.
  activities PersonActivity[]
  /// Сан у церкві: диякон, пресвітер, пастор — незалежно від служінь.
  churchRoles ChurchRole[]
  /// Служіння з роллю в кожному — керівник, помічник чи учасник.
  ministryAssignments MinistryAssignment[]
  /// A person can complete any number of trainings.
  trainings Training[]
  /// A leader may lead several trainings without completing them.
  leadingTrainings Training[] @relation("TrainingLeader")

  /// Відповідальний — team member carrying this person.
  responsible  String?

  birthDate   DateTime? @map("birth_date") @db.Date
  /// День і місяць народження як MMDD (0101–1231) — рік у пошуку іменинників не має значення.
  /// Колонку рахує Postgres (GENERATED ALWAYS … STORED), тому вона лише для читання: писати в неї не можна.
  birthMd     Int?      @map("birth_md") @db.SmallInt
  /// Водне хрещення.
  baptizedAt  DateTime? @map("baptized_at") @db.Date
  /// Став членом церкви.
  memberSince DateTime? @map("member_since") @db.Date
  /// Вибув з членства.
  leftAt      DateTime? @map("left_at") @db.Date

  notes String?

  /// Код_ЧлениЦеркви from the imported Access database — keeps the import idempotent.
  legacyId Int? @unique @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([membership])
  @@index([activity])
  @@index([birthMd])
  @@index([homeGroupId])
  @@map("people")
}
