/// A church community. People may belong to more than one community.
model Community {
  id String @id @default(uuid())

  name String @unique
  /// Окреме відгалуження — фактично церква в церкві, як D.Youth. Дає змогу
  /// дивитись на базу трьома способами: уся церква, лише відгалуження, решта.
  isBranch Boolean @default(false) @map("is_branch")

  /// Lower numbers are shown first in selectors, tabs and lists.
  sortOrder Int @default(100) @map("sort_order")

  people Person[]
  ministries Ministry[]

  /// A leader can lead several communities without being a member of them.
  leaderId String? @map("leader_id")
  leader   Person? @relation("CommunityLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  /// Зібрання спільноти.
  gatherings Gathering[]
  /// Кому довірено цю спільноту.
  userScopes UserScope[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leaderId])
  @@map("communities")
}
