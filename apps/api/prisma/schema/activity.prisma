/// Що саме сталося з карткою. Події життя людини (хрещення, членство) виводяться
/// з її дат, а тут лежать лише операції: хто, коли і що змінив.
enum ActivityKind {
  PERSON_CREATED
  FIELD_CHANGED
  RELATION_ADDED
  RELATION_REMOVED
  STEP_ADDED
  STEP_CHANGED
  STEP_REMOVED
  ROLE_ASSIGNED
  ROLE_CHANGED
  ROLE_REMOVED
  EVENT_ADDED
  EVENT_CHANGED
  EVENT_REMOVED

  @@map("activity_kinds")
}

/// Журнал змін картки: без нього неможливо відповісти, хто перевів людину
/// в неактивні або коли її додали в служіння.
model PersonActivity {
  id String @id @default(uuid())

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  kind ActivityKind

  /// Поле або сутність: "membership", "ministry", "step"…
  subject String
  /// Людиночитна ціль: назва служіння, кроку, сану.
  target   String?
  oldValue String? @map("old_value")
  newValue String? @map("new_value")

  /// Імʼя зберігаємо знімком: користувача можуть видалити, а запис лишається.
  actorId   String? @map("actor_id")
  actorName String  @map("actor_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([personId, createdAt])
  @@map("person_activities")
}
